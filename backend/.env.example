# Copy this file to .env and adjust as needed. No real secrets belong in source control.

# SQLite file path (relative to backend/ working directory)
DATABASE_URL=sqlite:///./data/pred_platform.db

# JWT signing — generate a real random value for anything beyond local dev,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=dev-only-change-me-1234567890abcdef1234567890abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Environment name, surfaced on /health for operator clarity. Setting this
# to "production" activates stricter startup config validation — see
# docs/RELIABILITY_AND_OPERATIONS.md §2 (it will refuse to start with the
# dev JWT secret, a wildcard CORS origin, or an in-memory database).
APP_ENV=development
LOG_LEVEL=INFO

# Background jobs (Phase 7): a job running longer than this is force-failed
# rather than left RUNNING forever. See app/jobs/runner.py.
JOB_TIMEOUT_SECONDS=300

# API reliability (Phase 7): requests with a larger Content-Length are
# rejected with 413 before any parsing happens.
MAX_REQUEST_BODY_BYTES=10485760

# Anti-brute-force on /auth/login (Phase 7) — in-memory, per-process, resets
# on restart. See docs/RELIABILITY_AND_OPERATIONS.md §10.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Optional AI copilot (Phase 9) — see docs/COPILOT.md. Leave
# ANTHROPIC_API_KEY unset (the default) to run with the copilot in "not
# configured" mode: every other feature in this platform is completely
# unaffected, and the copilot API honestly reports itself as unavailable
# rather than crashing or pretending. Never commit a real key here.
COPILOT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
COPILOT_LLM_MODEL=claude-3-5-haiku-20241022
COPILOT_LLM_TIMEOUT_SECONDS=30
COPILOT_MAX_EVIDENCE_ITEMS=12
