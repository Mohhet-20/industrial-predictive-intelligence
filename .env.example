# For docker-compose.yml only (the deployment-like container setup — see
# that file's own comment, and docs/RELIABILITY_AND_OPERATIONS.md §1/§17).
# Copy this to .env in this same directory before running `docker compose
# up`. Backend and frontend each also have their own .env.example for
# running outside Docker (backend/.env.example, frontend/.env.example) —
# this file is specifically what docker-compose.yml reads.

# Required — no default. Generate a real value, don't reuse this comment:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Origins allowed to call the API from a browser. If you change the
# frontend's published port below, update this to match.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# Build-time only (Vite inlines this into the compiled JS) — where the
# browser should reach the backend. Only change this if you also change
# the backend's published port in docker-compose.yml.
VITE_API_BASE_URL=http://localhost:8000/api/v1
